<!DOCTYPE html>
<html lang="id">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Dashboard Admin</title>

<link rel="stylesheet" href="/css/admin.css">

</head>

<body>

<div class="admin-wrapper">

<%- include("layout/sidebar") %>

<div class="admin-content">

<%- include("layout/header") %>

<div class="stats-grid">

<div class="stat-card">

<h3>Total Pesanan</h3>

<h1><%= orders.length %></h1>

</div>

<div class="stat-card">

<h3>Diproses</h3>

<h1>

<%= orders.filter(o=>o.status==="DIPROSES").length %>

</h1>

</div>

<div class="stat-card">

<h3>Selesai</h3>

<h1>

<%= orders.filter(o=>o.status==="SELESAI").length %>

</h1>

</div>

<div class="stat-card">

<h3>Pending</h3>

<h1>

<%= orders.filter(o=>o.status==="MENUNGGU_PEMBAYARAN").length %>

</h1>

</div>

</div>

<div class="admin-table">

<table>

<thead>

<tr>

<th>Invoice</th>

<th>Game</th>

<th>Produk</th>

<th>Status</th>

<th>Aksi</th>

</tr>

</thead>

<tbody>

<% orders.forEach(order=>{ %>

<tr>

<td><%= order.invoice %></td>

<td><%= order.game %></td>

<td><%= order.product %></td>

<td>

<% if(order.status==="MENUNGGU_PEMBAYARAN"){ %>

<span class="status pending">
Pending
</span>

<% }else if(order.status==="DIPROSES"){ %>

<span class="status proses">
Diproses
</span>

<% }else if(order.status==="SELESAI"){ %>

<span class="status selesai">
Selesai
</span>

<% }else{ %>

<span class="status batal">
Batal
</span>

<% } %>

</td>

<td>

<form action="/admin/order/status" method="POST">

<input
type="hidden"
name="invoice"
value="<%= order.invoice %>">

<select name="status">

<option value="MENUNGGU_PEMBAYARAN"
<%= order.status==="MENUNGGU_PEMBAYARAN" ? "selected" : "" %>>
Pending
</option>

<option value="DIPROSES"
<%= order.status==="DIPROSES" ? "selected" : "" %>>
Diproses
</option>

<option value="SELESAI"
<%= order.status==="SELESAI" ? "selected" : "" %>>
Selesai
</option>

<option value="BATAL"
<%= order.status==="BATAL" ? "selected" : "" %>>
Batal
</option>

</select>

<button type="submit">

Update

</button>

</form>

</td>

</tr>

<% }) %>

</tbody>

</table>

</div>

<div class="chart-card">

<h3>Grafik Order</h3>

<canvas id="orderChart"></canvas>

</div>

</div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/js/admin.js"></script>

</body>

</html>
