<%- include("../partials/header") %>
<%- include("../partials/navbar") %>

<section class="hero">

<div class="container">

<h1>Dashboard Admin</h1>

<br>

<div class="card">

<h3>Daftar Pesanan</h3>

<br>

<div style="overflow-x:auto">

<table style="width:100%;border-collapse:collapse;min-width:700px">

<thead>

<tr>
<th>Invoice</th>
<th>Game</th>
<th>Produk</th>
<th>Status</th>
</tr>

</thead>

<tbody>

<% if(orders.length===0){ %>

<tr>
<td colspan="4">Belum ada pesanan.</td>
</tr>

<% } %>

<% orders.forEach(order=>{ %>

<tr>

<td><%= order.invoice %></td>

<td><%= order.game %></td>

<td><%= order.product %></td>

<td>

<form action="/admin/order/status" method="POST">

<input 
type="hidden" 
name="invoice" 
value="<%= order.invoice %>"
>

<select name="status">

<option value="MENUNGGU_PEMBAYARAN"
<%= order.status==="MENUNGGU_PEMBAYARAN" ? "selected" : "" %>>
MENUNGGU PEMBAYARAN
</option>


<option value="DIPROSES"
<%= order.status==="DIPROSES" ? "selected" : "" %>>
DIPROSES
</option>


<option value="SELESAI"
<%= order.status==="SELESAI" ? "selected" : "" %>>
SELESAI
</option>


<option value="BATAL"
<%= order.status==="BATAL" ? "selected" : "" %>>
BATAL
</option>


</select>


<button type="submit">
UPDATE
</button>


</form>

</td>

</tr>

<% }) %>

</tbody>

</table>

</div>

</div>

</section>

<%- include("../partials/footer") %>
