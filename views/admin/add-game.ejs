<!DOCTYPE html>
<html lang="id">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Tambah Game</title>

<link rel="stylesheet" href="/css/admin.css">

</head>

<body>

<div class="admin-wrapper">

<%- include("layout/sidebar") %>

<div class="admin-content">

<%- include("layout/header") %>

<h2>Tambah Game</h2>

<form 
action="/admin/games/add" 
method="POST"
enctype="multipart/form-data">

<label>Nama Game</label>

<input
type="text"
name="name"
required>

<br><br>

<label>Slug</label>

<input
type="text"
name="slug"
required>

<br><br>

<label>Gambar Game</label>

<input
type="file"
name="image"
accept="image/*"
required>

<br><br>

<button
class="btn-primary">

Simpan

</button>

</form>

</div>

</div>

</body>

</html>
